# =============================================================================
# RWRRN — Organisation Configuration Template
# =============================================================================
# Copy this file to `.env` in the repo root and fill in the values for your
# organisation. This file is used by the scripts under scripts/ca-bootstrap/
# to generate crypto material via the live Fabric CA — NOT by docker-compose
# directly (docker-compose.yml still hardcodes TWS's own values for Stage 1).
#
# NEVER commit the filled-in `.env` file. Only `.env.template` (this file,
# with placeholder values) belongs in git. Add `.env` to .gitignore.
#
# When a new organisation (MC, NB, a future country org, ...) joins the
# network, they copy this template, replace ORG_CODE / ORG_DOMAIN / secrets
# with their own values, and run the same scripts against their own CA.
# =============================================================================

# --- Project name -------- -------------------------------------------------
COMPOSE_PROJECT_NAME=rwrrn

# --- Organisation identity -------------------------------------------------
ORG_CODE=tws
ORG_DOMAIN=tws.rwrrn.recordweb.dev

# MSP IDs (Model B: each organisation runs its own Peer-Org MSP AND its own
# Orderer-Org MSP; both are issued by this organisation's own CA)
PEER_MSP_ID=TWSOrgMSP
ORDERER_MSP_ID=TWSOrdererMSP

# --- Fabric CA connection ----------------------------------------------------
CA_NAME=ca-tws
CA_HOST=ca.tws.rwrrn.recordweb.dev
CA_PORT=7054
# TLS cert the fabric-ca-client uses to trust the CA's own TLS listener.
# Path is relative to where the cli container mounts crypto-config/fabric-ca.
CA_TLS_CERT_PATH=/opt/gopath/src/github.com/hyperledger/fabric/peer/fabric-ca/tws/tls-cert.pem

# --- CA bootstrap admin (one-time use, rotated/disabled after Step 2) ------
CA_BOOTSTRAP_USER=admin
CA_BOOTSTRAP_PASS=adminpw

# --- Organisation admin identity (registered fresh, replaces bootstrap admin
#     for all day-to-day operations once enrolled) --------------------------
ORDERER_ADMIN_USER=tws-orderer-admin
ORDERER_ADMIN_PASS=CHANGE_ME_ADMIN_SECRET
ORG_ADMIN_USER=tws-org-admin
ORG_ADMIN_PASS=CHANGE_ME_ADMIN_SECRET

# --- Orderer node identities -------------------------------------------------
ORDERER0_NAME=orderer0.tws.rwrrn.recordweb.dev
ORDERER0_ENROLL_ID=orderer0
ORDERER0_ENROLL_SECRET=CHANGE_ME_ORDERER0_SECRET

ORDERER1_NAME=orderer1.tws.rwrrn.recordweb.dev
ORDERER1_ENROLL_ID=orderer1
ORDERER1_ENROLL_SECRET=CHANGE_ME_ORDERER1_SECRET

ORDERER2_NAME=orderer2.tws.rwrrn.recordweb.dev
ORDERER2_ENROLL_ID=orderer2
ORDERER2_ENROLL_SECRET=CHANGE_ME_ORDERER0_SECRET

ORDERER3_NAME=orderer3.tws.rwrrn.recordweb.dev
ORDERER3_ENROLL_ID=orderer3
ORDERER3_ENROLL_SECRET=CHANGE_ME_ORDERER1_SECRET

# --- Peer node identities ----------------------------------------------------
PEER0_NAME=peer0.tws.rwrrn.recordweb.dev
PEER0_ENROLL_ID=peer0
PEER0_ENROLL_SECRET=CHANGE_ME_PEER0_SECRET

PEER1_NAME=peer1.tws.rwrrn.recordweb.dev
PEER1_ENROLL_ID=peer1
PEER1_ENROLL_SECRET=CHANGE_ME_PEER1_SECRET

COUCHDB_PASSWORD=CHANGE_ME_COUCHDB_SECRET

# --- Output paths (relative to repo root on the VPS) ------------------------
CRYPTO_CONFIG_DIR=./crypto-config
